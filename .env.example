# Rocketeerio environment variables
# Copy this file to .env.local for local development and set matching values in Vercel for production.

# Database
DATABASE_URL=

# Web push notifications
# Generated with: npx web-push generate-vapid-keys --json
# The public key is safe to expose to the browser; the private key must remain server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BC0UGSLR36Xn2PqvuOV1XzSXelFHbmZI3Ss9A3PMShoJmFFFHaKGoHzSYPPgGA7BCtT4_c76cJ4vxhmsdcpZiJo
VAPID_PRIVATE_KEY=SN3nOLf-namGH_GuEfnytYISDbzVnYOxAgy-y_a8hVE
VAPID_SUBJECT=mailto:hello@rocketeerio.com

# Shared secret used by the Railway Messenger middleware when it calls
# POST /api/push/send. Set the same value in both Vercel and Railway.
PUSH_NOTIFICATION_API_SECRET=xiggDiflk3ZF6ZYHYVFwZdsphSURsMVERU4jt6cf5ew=
